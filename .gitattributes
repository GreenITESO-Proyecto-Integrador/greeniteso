# Tratamiento predeterminado para archivos de texto: normalizar a LF
* text=auto eol=lf

# Reglas estrictas para scripts y archivos de automatización
Makefile text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf

# Archivos binarios (no modificar bajo ninguna circunstancia)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pyc binary